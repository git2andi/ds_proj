  "turns": [
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Hey everyone, let's get started.",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Today we are deciding: Plan a hiking trip through Norway",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Here are the options on the table:",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option A - Lofoten Islands: Offers breathtaking scenery with dramatic mountains and pristine beaches; trade-off: Requires more planning for transportation and accommodations; best for: Those prioritizing unique landscapes over ease of travel",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option B - Jotunheimen National Park: Provides a wide range of hiking trails for all skill levels, including the famous Besseggen Ridge hike; trade-off: Can be very crowded during peak season, reducing the sense of wilderness; best for: Hikers seeking variety and accessibility in trails",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option C - Trolltunga: Features a challenging hike to a unique rock formation with spectacular views, ideal for experienced hikers; trade-off: Demands higher physical fitness and endurance due to its difficulty; best for: Adventurers looking for a thrilling, off-the-beaten-path experience",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option D - Senja Island: Known as Norway's second-largest island, it offers diverse landscapes from beaches to mountains with fewer tourists than the southern parts of Norway; trade-off: Has limited amenities and services compared to more popular destinations; best for: Travelers seeking an authentic, less crowded hiking experience",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "What aspects of a hiking trip are most important to you - scenery, trail variety, challenge level, or avoiding crowds?",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 1,
      "phase": "opening",
      "speaker": "Lena",
      "is_moderator": false,
      "text": "Hey, for me it's about finding a balance between scenic views and safety.",
      "selected_reason": "weighted",
      "tokens_in": 1182,
      "tokens_out": 17
    },
    {
      "turn_index": 2,
      "phase": "opening",
      "speaker": "Kasper",
      "is_moderator": false,
      "text": "Hey, I'm thinking avoiding crowds is key for me.",
      "selected_reason": "weighted",
      "tokens_in": 1341,
