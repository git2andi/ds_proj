  "turns": [
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Hey everyone, let's get started.",
      "selected_reason": "moderator",
      "tokens_in": 0,
