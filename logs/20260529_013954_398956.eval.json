    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option A - Oceanview Resort: Relaxing beach vacation with amenities; tradeoff: Higher cost; concern: Less flexible if plans change; fit: Couples and honeymooners; uncertainty: Availability of rooms with ocean views; best for: Luxury-over-budget",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option B - Coastal Camping Site: Immersive nature experience with outdoor activities; tradeoff: Limited comforts; concern: Weather conditions affecting stay; fit: Adventure seekers and families with kids; uncertainty: Quality of camping facilities; best for: Experience-over-comfort",
      "selected_reason": "moderator",
      "tokens_in": 0,
