      "tokens_out": 22
    },
    {
      "turn_index": 19,
      "phase": "narrowing",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "I still think Option B is a better fit, it offers a broad overview which is more feasible for our goals.",
      "selected_reason": "weighted",
      "tokens_in": 935,
