      "tokens_out": 11
    },
    {
      "turn_index": 20,
      "phase": "narrowing",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "I'm okay with Option C if it has clear research paths, but I still prefer Option B for its broad overview.",
      "selected_reason": "weighted",
      "tokens_in": 940,
      "tokens_out": 25
    },
    {
      "turn_index": 21,
      "phase": "narrowing",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "I'm good with Option C if it has clear paths, but still prefer Option B.",
