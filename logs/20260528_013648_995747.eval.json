    },
    {
      "turn_index": 11,
      "phase": "negotiation",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Isn't specified, decide based on what's listed.",
      "selected_reason": "moderator",
      "tokens_in": 470,
      "tokens_out": 12
    },
    {
      "turn_index": 12,
      "phase": "negotiation",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "Breadth can be valuable for finding unusual connections, though.",
      "selected_reason": "weighted",
      "tokens_in": 928,
      "tokens_out": 14
    },
    {
      "turn_index": 12,
      "phase": "narrowing",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Time to narrow it down \u2014 which option works best for each of you?",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 13,
      "phase": "narrowing",
      "speaker": "Ethan",
      "is_moderator": false,
      "text": "I think Liam's point on breadth is valid, but depth matters too.",
      "selected_reason": "weighted",
      "tokens_in": 916,
      "tokens_out": 16
    },
    {
      "turn_index": 14,
      "phase": "narrowing",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "I think depth in innovative apps is more valuable than breadth here.",
      "selected_reason": "weighted",
      "tokens_in": 924,
