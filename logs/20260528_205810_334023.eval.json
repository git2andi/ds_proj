    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Today we are deciding: should we order pizza or cook at home tonight",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Here are the options on the table:",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option A - Domino's Pizza: convenient and quick delivery; trade-off: less control over ingredients; best for: busy households",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option B - Homemade Pasta: allows for customization of ingredients and dietary preferences; trade-off: requires more time and effort; best for: health-conscious individuals",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option C - Pizza Hut: offers a wide range of toppings and promotions; trade-off: potentially lower quality ingredients; best for: families with diverse tastes",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option D - Local Pizzeria: supports the local economy and may offer unique flavors; trade-off: possibly higher cost and limited delivery area; best for: those prioritizing community support",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "What's most important to you tonight, convenience, customization, variety, or supporting local businesses?",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 1,
      "phase": "opening",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "Healthier options matter to me tonight",
