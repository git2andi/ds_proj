    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Here are the options on the table:",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option A - The Delaunay: upscale atmosphere and wide menu variety; tradeoff: higher cost; concern: less flexible if plans change; fit: special occasions or business meetings; uncertainty: availability of outdoor seating; best for: quality-over-quantity",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option B - Dishoom Covent Garden: vibrant Indian cuisine and lively ambiance; tradeoff: potentially loud environment; concern: wait times can be long; fit: groups of friends or adventurous eaters; uncertainty: spice level of certain dishes; best for: flavor-over-familiarity",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option C - The Breakfast Club Soho: extensive breakfast options and cozy setting; tradeoff: limited lunch choices; concern: queues on weekends; fit: families or those seeking a casual meal; uncertainty: wait time for takeout orders; best for: comfort-over-innovation",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option D - Padella London: fresh, handmade pasta and intimate setting; tradeoff: narrower menu selection; concern: seating is limited; fit: couples or pasta enthusiasts; uncertainty: daily specials availability; best for: authenticity-over-variety",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
