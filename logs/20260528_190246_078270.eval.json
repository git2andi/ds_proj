      "tokens_in": 1126,
      "tokens_out": 19
    },
    {
      "turn_index": 4,
      "phase": "negotiation",
      "speaker": "Julian",
      "is_moderator": false,
      "text": "Aiden's right, variety keeps things fresh, but does Jackbox Party Pack really offer that with its repetitive games?",
      "selected_reason": "weighted",
      "tokens_in": 1410,
      "tokens_out": 25
    },
    {
      "turn_index": 5,
      "phase": "negotiation",
      "speaker": "Lena",
      "is_moderator": false,
      "text": "I think Overcooked 2 is a better fit for engagement and teamwork.",
      "selected_reason": "weighted",
      "tokens_in": 1368,
      "tokens_out": 16
    },
    {
      "turn_index": 6,
      "phase": "negotiation",
      "speaker": "Julian",
      "is_moderator": false,
      "text": "Lena, Overcooked 2 can get chaotic, will that keep everyone engaged?",
      "selected_reason": "weighted",
      "tokens_in": 1455,
      "tokens_out": 18
    },
    {
      "turn_index": 7,
      "phase": "negotiation",
      "speaker": "Lena",
      "is_moderator": false,
      "text": "Yeah, chaos can be an issue in Overcooked 2 if we don't communicate well.",
