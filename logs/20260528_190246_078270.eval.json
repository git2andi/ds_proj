      "tokens_in": 1454,
      "tokens_out": 18
    },
    {
      "turn_index": 10,
      "phase": "negotiation",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Hey Julian and Lena, can you respond to each other's concerns?",
