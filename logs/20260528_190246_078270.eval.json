      "tokens_in": 1374,
      "tokens_out": 20
    },
    {
      "turn_index": 8,
      "phase": "negotiation",
      "speaker": "Julian",
      "is_moderator": false,
      "text": "Chaos in Overcooked 2 might overwhelm some players, I'm worried about that.",
      "selected_reason": "weighted",
      "tokens_in": 1447,
      "tokens_out": 19
    },
    {
      "turn_index": 9,
      "phase": "negotiation",
      "speaker": "Lena",
      "is_moderator": false,
      "text": "I think we can mitigate that overwhelm with clear communication, Julian.",
