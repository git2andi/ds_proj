      "tokens_in": 1279,
      "tokens_out": 22
    },
    {
      "turn_index": 5,
      "phase": "negotiation",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "But is it worth the higher cost though?",
      "selected_reason": "forced",
      "tokens_in": 1350,
      "tokens_out": 10
    },
    {
      "turn_index": 6,
      "phase": "negotiation",
      "speaker": "Lena",
      "is_moderator": false,
      "text": "Higher cost is a trade-off, but I think SAS Flight 101's reliability is worth it after my delay experience.",
      "selected_reason": "weighted",
      "tokens_in": 1236,
      "tokens_out": 25
    },
    {
      "turn_index": 7,
      "phase": "negotiation",
      "speaker": "Kai",
      "is_moderator": false,
      "text": "Higher cost is a big trade-off for me.",
