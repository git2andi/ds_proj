    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Today we are deciding: Book a flight to Stockholm",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Here are the options on the table:",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option A - SAS Flight 101: Convenient departure time; trade-off: Higher cost; best for: Business travelers",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option B - Norwegian Air Shuttle: Affordable prices; trade-off: Less legroom; best for: Budget-conscious tourists",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option C - Lufthansa LH1234: Comprehensive in-flight entertainment; trade-off: Longer layover; best for: Families with children",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option D - Finnair AY5678: Scenic route over the Baltic Sea; trade-off: Less frequent departures; best for: Nature lovers and photographers",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "What's our top priority for this flight to Stockholm: budget, convenience, entertainment, or scenic views?",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 1,
      "phase": "opening",
      "speaker": "Lena",
      "is_moderator": false,
      "text": "Hi, reliability is key for me after a bad experience with delays.",
      "selected_reason": "weighted",
      "tokens_in": 1014,
      "tokens_out": 15
    },
    {
      "turn_index": 2,
      "phase": "opening",
      "speaker": "Kai",
      "is_moderator": false,
      "text": "Hey, hoping for transparent pricing and flexible booking options.",
      "selected_reason": "weighted",
      "tokens_in": 1062,
      "tokens_out": 12
    },
    {
      "turn_index": 3,
      "phase": "opening",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "Hey, convenience matters most to me",
      "selected_reason": "weighted",
      "tokens_in": 1101,
      "tokens_out": 8
    },
    {
      "turn_index": 4,
      "phase": "negotiation",
      "speaker": "Lena",
      "is_moderator": false,
      "text": "Ava, convenience is great but doesn't SAS Flight 101 offer that with a convenient departure time?",
