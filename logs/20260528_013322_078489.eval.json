  "turns": [
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Hey everyone, let's get started.",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Today we are deciding: lets find a lunch break spot",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Here are the options on the table:",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option A - Bella Vita Cafe: convenient location; trade-off: higher cost; best for: teams who value time efficiency",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option B - The Green Bistro: healthy menu options; trade-off: slower paced service; best for: individuals prioritizing wellness",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option C - Sunny Street Eats: diverse food variety; trade-off: longer walk from the office; best for: groups seeking a change of scenery",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Option D - Metro Grill House: generous portions; trade-off: noisier atmosphere; best for: teams who value filling meals",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 0,
      "phase": "opening",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "What's our top priority for this lunch break - saving time, eating healthy, exploring new spots, or having a hearty meal?",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 1,
      "phase": "opening",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "Hi everyone, hoping we can find a spot that accommodates various dietary preferences",
      "selected_reason": "weighted",
      "tokens_in": 928,
      "tokens_out": 16
    },
    {
      "turn_index": 2,
      "phase": "opening",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "Hi, I'm thinking we should prioritize having familiar sandwich options available.",
      "selected_reason": "weighted",
      "tokens_in": 951,
      "tokens_out": 15
    },
    {
      "turn_index": 3,
      "phase": "opening",
      "speaker": "Julian",
      "is_moderator": false,
      "text": "Need something filling and affordable, been struggling to find that around here",
      "selected_reason": "weighted",
      "tokens_in": 934,
      "tokens_out": 14
    },
    {
      "turn_index": 4,
      "phase": "negotiation",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "Filling and affordable is key, what about Option D for generous portions?",
      "selected_reason": "weighted",
      "tokens_in": 1012,
      "tokens_out": 16
    },
    {
      "turn_index": 5,
      "phase": "negotiation",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "Is Metro Grill House known for having good sandwiches though?",
      "selected_reason": "weighted",
      "tokens_in": 995,
      "tokens_out": 12
    },
    {
      "turn_index": 5,
      "phase": "negotiation",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Not specified, decide based on listed features.",
      "selected_reason": "moderator",
      "tokens_in": 525,
      "tokens_out": 10
    },
    {
      "turn_index": 6,
      "phase": "negotiation",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "Let's consider The Green Bistro for healthier options then.",
      "selected_reason": "weighted",
      "tokens_in": 947,
      "tokens_out": 13
    },
    {
      "turn_index": 7,
      "phase": "negotiation",
      "speaker": "Julian",
      "is_moderator": false,
      "text": "Healthier doesn't necessarily mean filling or affordable",
      "selected_reason": "weighted",
      "tokens_in": 973,
      "tokens_out": 10
    },
    {
      "turn_index": 8,
      "phase": "negotiation",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "Does The Green Bistro have familiar sandwich options though?",
      "selected_reason": "weighted",
      "tokens_in": 975,
      "tokens_out": 12
    },
    {
      "turn_index": 9,
      "phase": "negotiation",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "The Green Bistro's menu isn't detailed here, so let's look at Sunny Street Eats for variety instead.",
      "selected_reason": "weighted",
      "tokens_in": 936,
      "tokens_out": 25
    },
    {
      "turn_index": 10,
      "phase": "negotiation",
      "speaker": "Julian",
      "is_moderator": false,
      "text": "Sunny Street Eats is a longer walk though.",
      "selected_reason": "weighted",
      "tokens_in": 975,
      "tokens_out": 12
    },
    {
      "turn_index": 11,
      "phase": "negotiation",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "Yeah, it's a bit farther, but variety might be worth it.",
      "selected_reason": "weighted",
      "tokens_in": 965,
      "tokens_out": 16
    },
    {
      "turn_index": 12,
      "phase": "negotiation",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "Worth it for diverse food options and a change of scenery.",
      "selected_reason": "weighted",
      "tokens_in": 971,
      "tokens_out": 14
    },
    {
      "turn_index": 12,
      "phase": "narrowing",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "Let's hear it: one option each, and a backup if you're unsure.",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 13,
      "phase": "narrowing",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "I'd prefer Option A, it's convenient and has familiar options.",
      "selected_reason": "weighted",
      "tokens_in": 956,
      "tokens_out": 15
    },
    {
      "turn_index": 14,
      "phase": "narrowing",
      "speaker": "Julian",
      "is_moderator": false,
      "text": "I'd prefer Option D for generous portions.",
      "selected_reason": "weighted",
      "tokens_in": 953,
      "tokens_out": 10
    },
    {
      "turn_index": 15,
      "phase": "narrowing",
      "speaker": "Ava",
      "is_moderator": false,
      "text": "I'm for Option C, it has diverse food options.",
      "selected_reason": "weighted",
      "tokens_in": 936,
      "tokens_out": 13
    },
    {
      "turn_index": 16,
      "phase": "emergence",
      "speaker": "Liam",
      "is_moderator": false,
      "text": "Option C works if Sunny Street Eats has good sandwich reviews.",
      "selected_reason": "weighted",
      "tokens_in": 978,
      "tokens_out": 14
    },
    {
      "turn_index": 16,
      "phase": "confirmation",
      "speaker": "Moderator",
      "is_moderator": true,
      "text": "sounds like we're landing on Option C -- everyone good with that?",
      "selected_reason": "moderator",
      "tokens_in": 0,
      "tokens_out": 0
    },
    {
      "turn_index": 16,
      "phase": "confirmation",
