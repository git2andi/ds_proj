    {
      "index": 4,
      "phase": "OPENING",
      "speaker_id": "p2",
      "speaker_name": "Ben",
      "text": "Battery life matters most to me, so I’m leaning toward the battery laptop since it lasts the longest. We need something that stays powered through the day without constant charging.",
